# Servicio systemd de TechRetAI.
# Instalación (una sola vez, en la VM):
#   sudo cp deploy/techretai.service /etc/systemd/system/techretai.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now techretai
#
# Las credenciales y modelos se leen de /etc/techretai.env (fuera del repo).
[Unit]
Description=TechRetAI - Asistente RAG Corporativo
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/agente_ia_challengue_alura
EnvironmentFile=/etc/techretai.env
ExecStart=/home/ubuntu/agente_ia_challengue_alura/.venv/bin/streamlit run app/streamlit_app.py --server.address 0.0.0.0 --server.port 8501 --server.headless true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
